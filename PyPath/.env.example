# Docker Compose / PostgreSQL
POSTGRES_DB=python_learning
POSTGRES_USER=python_learning
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_EXPOSE_PORT=5432

# Django
# Generate a new value for non-local environments. Never commit a real secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_PORT=8000

# Django -> FastAPI service communication.  Docker resolves ocr-service by name.
FASTAPI_URL=http://ocr-service:8001
FASTAPI_OCR_URL=http://ocr-service:8001/api/v1/grade-image
FASTAPI_TIMEOUT_SECONDS=20

# FastAPI / OCR / code-runner safety limits
# Leave blank inside Docker.  On Windows local execution, set this to tesseract.exe.
TESSERACT_CMD=
OCR_LANGUAGE=eng
FASTAPI_PORT=8001
CODE_TIMEOUT_SECONDS=3
MAX_CODE_TIMEOUT_SECONDS=10
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
MAX_SOURCE_BYTES=50000
MAX_STDIN_BYTES=65536
MAX_OUTPUT_BYTES=65536
CODE_MEMORY_LIMIT_MB=128
