# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL
POSTGRES_DB=python_learning
POSTGRES_USER=python_learning
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# FastAPI OCR/grading service
FASTAPI_OCR_URL=http://127.0.0.1:8001/api/v1/grade-image
FASTAPI_TIMEOUT_SECONDS=20

# Optional: only useful for local Django tests or a quick no-PostgreSQL demo.
# Django automatically uses an in-memory SQLite database for `manage.py test`.
# DJANGO_USE_SQLITE=False
